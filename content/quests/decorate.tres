[gd_resource type="Resource" script_class="QuestDef" format=3]

[ext_resource type="Script" path="res://modules/quests/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://modules/quests/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
event = "entered:home"
instruction = "Go back home through the yellow door."

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
event = "placed:*"
instruction = "Use the board on the wall to get furniture, then move it where you like."

[resource]
script = ExtResource("1_quest")
title = "Make It Yours"
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2")])
completed_text = "Your home looks lovely!"
