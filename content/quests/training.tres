[gd_resource type="Resource" script_class="QuestDef" format=3]

[ext_resource type="Script" path="res://modules/quests/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://modules/quests/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
event = "caught:butterfly"
count = 3
instruction = "A butterfly! Follow it and catch it with your hand. Catch three."

[resource]
script = ExtResource("1_quest")
title = "Butterfly Training"
start_on = "entered:training"
steps = Array[ExtResource("2_step")]([SubResource("Step_1")])
rewards = Dictionary[StringName, int]({&"coin": 3})
completed_text = "Well done! Take the Backyard door to explore outside."
