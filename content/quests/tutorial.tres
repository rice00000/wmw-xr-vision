[gd_resource type="Resource" script_class="QuestDef" format=3]

[ext_resource type="Script" path="res://modules/quests/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://modules/quests/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
event = "grabbed:ball"
instruction = "Welcome home! Reach out and grab the glowing ball. Hold the grip button."

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
event = "pressed:hello"
instruction = "Great! Now touch the orange button on the table."

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("2_step")
event = "entered:training"
instruction = "Walk through the yellow door to the Training Room."

[resource]
script = ExtResource("1_quest")
title = "Welcome Home"
start_on = "entered:home"
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3")])
rewards = Dictionary[StringName, int]({&"coin": 2})
