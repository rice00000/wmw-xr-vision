[gd_resource type="Resource" script_class="TaskDef" format=3]

[ext_resource type="Script" path="res://modules/tasks/task_def.gd" id="1_task"]
[ext_resource type="Script" path="res://modules/tasks/task_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_rounds"]
script = ExtResource("2_step")
count = 5
trial = &"catch"
place = &"meadow"
instruction = "Sit on the log in the meadow. Catch the butterfly with your hand."

[resource]
script = ExtResource("1_task")
title = "Butterflies"
steps = Array[ExtResource("2_step")]([SubResource("Step_rounds")])
rewards = Dictionary[StringName, int]({&"magic_stone": 2})
completed_text = "Five butterflies! Two Magic Stones for you."
next = &"first_furniture"
requires = Array[StringName]([&"find_it"])
repeatable = true
