[gd_resource type="Resource" script_class="TrialDef" format=3]

[ext_resource type="Script" path="res://modules/trials/trial_def.gd" id="1_trial"]
[ext_resource type="Script" path="res://modules/trials/trial_axis.gd" id="2_axis"]

[sub_resource type="Resource" id="Axis_speed"]
script = ExtResource("2_axis")
name = &"speed"
easy = 0.12
hard = 0.8
driven = true

[sub_resource type="Resource" id="Axis_size"]
