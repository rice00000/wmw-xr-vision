[resource]
script = ExtResource("1_trial")
title = "Self-test round"
skill = &"selftest"
axes = Array[ExtResource("2_axis")]([SubResource("Axis_clutter"), SubResource("Axis_overlap"), SubResource("Axis_contrast")])
notes = "The Test Room's round, not a child's. Its own skill bucket, so pressing
the station's button can never move the staircase the game trains, and its own
trial id, so its lines are one grep away from the research log.

Nothing is driven: a station must behave the same every time it is pressed, or
the verdict on the sign would not mean anything. No probe rounds either, so the
single round the station runs is scored and logged like a real one."
up_after = 2
step = 0.1
hint_after = 8.0
hint_fade = 0.0
max_hint = 3
probe_rounds = 0
probe_difficulty = 0.3
