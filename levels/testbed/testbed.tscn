[node name="Check01Player" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.3, 0, 2.5)
script = ExtResource("5_player")
title = "Player rig"
checks = "a hand can grab, and B / Y asks the guide for help"
action = "grab the ball, then press B or Y"
pass_when = "both lines below read OK"
object = ExtResource("16_ball")

[node name="Check02Save" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.3, 0, 0.8)
script = ExtResource("6_save")
module = &"Save"
title = "Save"
checks = "a number written to disk comes back after a reload"
action = "touch Add 1, then touch Save + reload"
pass_when = "the counter is still 1 after the reload"

[node name="Check03Inventory" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.3, 0, -0.9)
script = ExtResource("7_inventory")
module = &"Inventory"
title = "Inventory"
checks = "a granted item lands in the count"
action = "touch Give 1 Magic Stone"
pass_when = "the Magic Stone count goes up by exactly one"
item = &"magic_stone"

[node name="Check04Tasks" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.3, 0, -2.6)
script = ExtResource("8_chain")
module = &"Tasks"
title = "Tasks: chain"
checks = "a step advances on its fact, the next follows, the reward is paid"
action = "touch Report a fact twice"
pass_when = "both steps done and one Magic Stone paid"

[node name="Check05Trial" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.3, 0, -4.3)
script = ExtResource("9_trial")
title = "Trials: round"
checks = "a measured round builds itself, scores the pick and logs it"
action = "touch Start a round, then grab the object it names"
pass_when = "picked and wanted are the same object"
objects = Array[PackedScene]([ExtResource("17_cup"), ExtResource("18_book"), ExtResource("19_kettle"), ExtResource("16_ball")])

[node name="Check06Training" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.3, 0, -6)
script = ExtResource("10_training")
module = &"Training"
title = "Training"
checks = "the staircase rises after two right and falls after one wrong"
action = "touch Right, Right, then Wrong"
pass_when = "the four numbers go up, then back down"

[node name="Check07Vision" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.3, 0, 2.5)
script = ExtResource("11_vision")
module = &"Vision"
title = "Vision"
checks = "a spirit ability re-grades the whole room, not just the sign"
action = "touch the spirit orb"
pass_when = "the room jumps in contrast and the number below changes"
profile = ExtResource("20_contrast")

[node name="Check08Audio" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.3, 0, 0.8)
script = ExtResource("12_audio")
module = &"Audio"
title = "Audio: seam"
checks = "a spoken line and a sound at a place both come out"
action = "touch Say + beep"
pass_when = "you hear a beep on your right and the subtitle appears"

[node name="Check09SoundTable" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.3, 0, -0.9)
script = ExtResource("23_table")
module = &"Audio"
title = "Audio: table"
checks = "a button is heard, with no audio code behind the button"
action = "touch Press me"
pass_when = "you hear it, and the table says which row chose the sound"

[node name="Check10Placement" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.3, 0, -2.6)
script = ExtResource("13_placement")
module = &"Inventory"
title = "Placement"
checks = "furniture comes out of the bag into your hand, settles, goes back in"
action = "Take a chair out, let go, grab it, touch Put away with the other hand"
pass_when = "all three steps OK and the chair count is back where it was"
item = &"chair"

[node name="Check11Creatures" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.3, 0, -4.3)
script = ExtResource("14_creatures")
title = "Creatures"
checks = "touching a creature catches it: it reports the catch and leaves"
action = "touch the butterfly"
pass_when = "caught is reported and the butterfly is gone"
creature = ExtResource("21_butterfly")

[node name="Check12Debug" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.3, 0, -6)
script = ExtResource("15_debug")
module = &"Debug"
title = "Debug panel"
checks = "the hidden difficulty panel opens on the Menu button"
action = "hold Menu and press left Y"
pass_when = "a panel appears in front of your face"

[node name="Check13Menu" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.3, 0, -7.6)
script = ExtResource("24_menu")
module = &"Menu"
title = "Wrist menu"
checks = "the star on your wrist opens the menu, and the world waits while it is open"
action = "touch the star on your left wrist with your right hand, then touch Close"
pass_when = "paused while open, running again after"

